# Byaan for Teams — Self-Hosted Configuration
# Generated by installer with APP_SECRET pre-filled


# REQUIRED: Secret key for encryption (auto-generated by installer)
APP_SECRET=

# REQUIRED: Master admin account (created on first run)
MASTER_USER_EMAIL=admin@example.com
MASTER_USER_PASSWORD=changeme123

# REQUIRED: Organization name
ORG_NAME=My Company

# OPTIONAL: Domain configuration (leave as localhost for local testing)
DOMAIN=localhost

# OPTIONAL: Email for Let's Encrypt SSL (required if using custom domain)
# ACME_EMAIL=admin@example.com

# OPTIONAL: Docker image version (leave empty for latest)
BYAAN_VERSION=

# OPTIONAL: Google OAuth (leave empty to disable)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# VITE_GOOGLE_CLIENT_ID=
# RECOMMENDED FOR TEAMS: hide email/password login after Google OAuth is configured
# HIDE_EMAIL_AUTH=true

# OPTIONAL: SMTP Email settings (leave empty to disable email)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=noreply@example.com
# SMTP_FROM_NAME=Byaan
# SMTP_USE_TLS=true

# OPTIONAL: Health check timeout during updates
# HEALTH_CHECK_TIMEOUT=180      # Wait up to N seconds for container startup (default: 180 = 3 minutes)

# OPTIONAL: Worker URL for Byaan-managed features (PDF export, public share links,
# AI dashboard screenshots, and PNG previews in Slack threads / scheduled reports).
# Leave empty to disable these features. Slack Q&A and scheduled reports still work
# without it — just text + interactive HTML, no inline image.
# Contact support@byaan.ai if you want these features provisioned for your deployment.
# WORKER_URL=
